    {
      "parameters": {
        "jsCode": "return items.map(item => {\n    const d = item.json;\n    \n    const rawStatus = String(d.status || '').trim().toLowerCase();\n    \n    return {\n        json: {\n            date: d.date,\n            transaction_id: d.transaction_id,\n            user_id: d.user_id,\n            product: d.product,\n            amount: parseFloat(d.amount) || 0,\n            currency: d.currency || 'USD',\n            status: rawStatus,\n            channel: d.channel,\n            country: d.country,\n            is_success: rawStatus === 'paid'\n        }\n    };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        384,
        0
      ],
      "id": "61aa30c5-ccdd-4d1b-9875-fb593dfe2044",
      "name": "Clean & Enrich Data",
      "notesInFlow": true,
      "notes": "Cleans raw transaction data to identify successful payments"
    },
    {
      "parameters": {
        "jsCode": "const all = items.map(i => i.json);\n\nlet totalRevenue = 0;\nlet paidCount = 0;\nlet failedCount = 0;\n\nconst channelRevenue = {};\nconst countryRevenue = {};\n\nall.forEach(tx => {\n    const amount = tx.amount || 0;\n    const isPaid = tx.is_success === true;\n\n    if (isPaid) {\n        totalRevenue += amount;\n        paidCount++;\n\n        const channel = tx.channel || 'unknown';\n        channelRevenue[channel] = (channelRevenue[channel] || 0) + amount;\n\n        const country = tx.country || 'unknown';\n        countryRevenue[country] = (countryRevenue[country] || 0) + amount;\n    } else {\n        failedCount++;\n    }\n});\n\n// Топ канал и страна\nlet topChannel = '—';\nlet topCountry = '—';\n\nif (Object.keys(channelRevenue).length > 0) {\n    topChannel = Object.keys(channelRevenue).reduce((a, b) => \n        channelRevenue[a] > channelRevenue[b] ? a : b\n    );\n}\n\nif (Object.keys(countryRevenue).length > 0) {\n    topCountry = Object.keys(countryRevenue).reduce((a, b) => \n        countryRevenue[a] > countryRevenue[b] ? a : b\n    );\n}\n\nconst totalTransactions = all.length;\nconst failedRate = totalTransactions > 0 \n    ? ((failedCount / totalTransactions) * 100).toFixed(1) + '%' \n    : '0%';\n\nreturn [{\n    json: {\n        report_date: new Date().toISOString().split('T')[0],\n        total_revenue: Math.round(totalRevenue * 100) / 100,\n        paid_count: paidCount,\n        failed_count: failedCount,\n        failed_rate: failedRate,\n        total_transactions: totalTransactions,\n        top_channel: topChannel,\n        top_country: topCountry\n    }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        752,
        0
      ],
