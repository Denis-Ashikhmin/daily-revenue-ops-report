        "jsCode": "return items.map(item => {\n    // Берём текст из возможных вариантов структуры\n    let aiText = '';\n    \n    if (item.json && item.json[0] && item.json[0].text) {\n        aiText = item.json[0].text;\n    } else if (item.json && item.json.text) {\n        aiText = item.json.text;\n    } else if (typeof item.json === 'string') {\n        aiText = item.json;\n    }\n    \n    return {\n        json: {\n            ...item.json,           // сохраняем все предыдущие поля (report_date, revenue и т.д.)\n            ai_insights: aiText\n        }\n    };\n});"
